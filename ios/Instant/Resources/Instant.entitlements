<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Lets password managers treat the app as the Lounge website, so they
	     suggest the account already saved for lounge.eduardcazacu.com. The
	     site vouches back in frontend/public/.well-known/apple-app-site-association;
	     both halves are needed or iOS silently ignores this. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:lounge.eduardcazacu.com</string>
	</array>
	<!-- Shared with the widget extension: the app writes the snapshot the
	     widget draws, because an extension can reach neither the access token
	     nor the refresh cookie it would need to fetch for itself. -->
	<!-- On-device nudity detection for received instants, which the server
	     cannot inspect because it only ever holds ciphertext. It runs only for
	     people who turned on Sensitive Content Warnings or Communication
	     Safety. See Core/Media/SensitivityCheck.swift. -->
	<key>com.apple.developer.sensitivecontentanalysis.client</key>
	<array>
		<string>analysis</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.eduardcazacu.instant</string>
	</array>
</dict>
</plist>

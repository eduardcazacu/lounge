generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           Int       @id @default(autoincrement())
  email                        String    @unique
  name                         String?
  bio                          String    @default("")
  status                       String    @default("approved")
  createdAt                    DateTime  @default(now()) @map("created_at")
  approvedBy                   Int?      @map("approved_by")
  password                     String
  themeKey                     String    @default("boring-grey") @map("theme_key")
  emailVerifiedAt              DateTime? @map("email_verified_at")
  emailVerificationTokenHash   String?   @map("email_verification_token_hash")
  emailVerificationExpiresAt   DateTime? @map("email_verification_expires_at")
  passwordResetTokenHash       String?   @map("password_reset_token_hash")
  passwordResetExpiresAt       DateTime? @map("password_reset_expires_at")
  notificationsEnabled         Boolean   @default(true) @map("notifications_enabled")
  // Books' three kinds of notification, each switchable on its own under the
  // account's master switch above (which still governs everything, Instant
  // included). Replies in a review's discussion; book club notes that have
  // become readable; and friends starting or finishing a book you want to
  // read or are reading.
  notifyBookDiscussion         Boolean   @default(true) @map("notify_book_discussion")
  notifyBookClub               Boolean   @default(true) @map("notify_book_club")
  notifyBookActivity           Boolean   @default(true) @map("notify_book_activity")
  profilePictureKey            String?   @map("profile_picture_key")
  groupId                      Int       @map("group_id")
  // When the person agreed to the Community Guidelines. Null means the app
  // must ask before letting them in. Server-side, so once covers every device.
  termsAcceptedAt              DateTime? @map("terms_accepted_at")

  group      Group     @relation(fields: [groupId], references: [id])
  posts      Post[]
  comments   Comment[] @relation("CommentAuthor")
  postLikes  PostLike[]
  commentLikes CommentLike[]
  sessions   Session[]
  pushSubscriptions UserPushSubscription[]
  instantDeviceKeys InstantDeviceKey[]
  instantsSent     Instant[] @relation("InstantSender")
  instantsReceived Instant[] @relation("InstantRecipient")
  streaksAsLow     InstantStreak[] @relation("StreakLow")
  streaksAsHigh    InstantStreak[] @relation("StreakHigh")
  blocksMade       UserBlock[]     @relation("BlockBlocker")
  blocksReceived   UserBlock[]     @relation("BlockBlocked")
  reportsMade      ContentReport[] @relation("ReportReporter")
  reportsReceived  ContentReport[] @relation("ReportReported")
  shelfEntries     ShelfEntry[]
  progressLogs     ProgressLog[]
  shelfReviewComments ShelfReviewComment[]
  notificationsSent   NotificationSent[]
  readerSync          ReaderSync?
  readerDocuments     ReaderDocument[]

  @@index([groupId])
  @@map("users")
}

// Groups partition the app: a user only ever sees people, posts, reviews
// and instants from their own group. "main" holds the real community; "testing"
// holds the App Store review accounts. See backend/README.md.
model Group {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("groups")
}

model UserPushSubscription {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  endpoint String   @unique @map("endpoint")
  // "webpush" (endpoint + p256dh + auth) or "apns" (endpoint holds the device token).
  provider String   @default("webpush") @map("provider")
  p256dh   String?  @map("p256dh")
  auth     String?  @map("auth")
  userAgent String? @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_push_subscriptions")
  @@index([userId])
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  imageKey  String?   @map("image_key")
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")
  authorId  Int       @map("author_id")
  // Set when the post is a review cross-posted from /books. The card is drawn
  // from the review through this relation, so editing the review edits the
  // card; title and content are only a plain-text fallback.
  shelfReviewId Int?  @unique @map("shelf_review_id")

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     PostLike[]
  shelfReview ShelfReview? @relation(fields: [shelfReviewId], references: [id], onDelete: SetNull)

  @@map("posts")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")
  postId    Int      @map("post_id")
  authorId  Int      @map("author_id")

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  likes     CommentLike[]

  @@map("comments")
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId], map: "post_likes_post_id_user_id_key")
  @@map("post_likes")
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  commentId Int      @map("comment_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId], map: "comment_likes_comment_id_user_id_key")
  @@map("comment_likes")
}

model Session {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Instant — expiring, end-to-end encrypted 1:1 photos.
//
// The server stores ciphertext (in R2) and per-device *wrapped* content keys.
// It holds no key material it can unwrap: that requires a private key which
// never leaves the recipient's device. See backend/README.md for the full
// threat model, including what this does NOT defend against.
// ---------------------------------------------------------------------------

model InstantDeviceKey {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  deviceId   String    @map("device_id")
  // Raw uncompressed P-256 public point, base64url.
  publicKey  String    @map("public_key")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelopes InstantKeyEnvelope[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("instant_device_keys")
}

model Instant {
  id              String    @id @default(uuid())
  senderId        Int       @map("sender_id")
  recipientId     Int       @map("recipient_id")
  // All four of these are nulled the moment the media is fetched or expires.
  mediaKey        String?   @map("media_key")
  mediaIv         String?   @map("media_iv")
  ephemeralPubKey String?   @map("ephemeral_pub_key")
  mediaType       String    @default("image/webp") @map("media_type")
  byteSize        Int       @map("byte_size")
  durationMode    String    @map("duration_mode")
  createdAt       DateTime  @default(now()) @map("created_at")
  openedAt        DateTime? @map("opened_at")
  viewedAt        DateTime? @map("viewed_at")
  expiresAt       DateTime  @map("expires_at")

  sender    User                 @relation("InstantSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User                 @relation("InstantRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  envelopes InstantKeyEnvelope[]

  @@index([recipientId, openedAt])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("instants")
}

model InstantKeyEnvelope {
  id          Int    @id @default(autoincrement())
  instantId   String @map("instant_id")
  deviceKeyId Int    @map("device_key_id")
  // AES-GCM(content key) under a key derived from ECDH + HKDF. base64url.
  wrappedKey  String @map("wrapped_key")
  wrapIv      String @map("wrap_iv")

  instant   Instant          @relation(fields: [instantId], references: [id], onDelete: Cascade)
  deviceKey InstantDeviceKey @relation(fields: [deviceKeyId], references: [id], onDelete: Cascade)

  @@unique([instantId, deviceKeyId])
  @@index([instantId])
  @@map("instant_key_envelopes")
}

model InstantStreak {
  id              Int       @id @default(autoincrement())
  // Always stored as (min(a, b), max(a, b)) so a pair has exactly one row.
  userLowId       Int       @map("user_low_id")
  userHighId      Int       @map("user_high_id")
  count           Int       @default(0)
  lastLowSentAt   DateTime? @map("last_low_sent_at")
  lastHighSentAt  DateTime? @map("last_high_sent_at")
  lastIncrementOn DateTime? @map("last_increment_on") @db.Date
  warnedForOn     DateTime? @map("warned_for_on") @db.Date

  userLow  User @relation("StreakLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("StreakHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([count])
  @@map("instant_streaks")
}

// ---------------------------------------------------------------------------
// Moderation — App Store Guideline 1.2 for user-generated content.
//
// A block cuts both directions: neither person can find, key or send to the
// other. A report reaches the admins by email and sits in /admin until it is
// resolved. See backend/README.md.
// ---------------------------------------------------------------------------

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model ContentReport {
  id             Int       @id @default(autoincrement())
  // Both nullable so a report outlives either account being deleted.
  reporterId     Int?      @map("reporter_id")
  reportedUserId Int?      @map("reported_user_id")
  // Plain string rather than a relation: instants are swept, reports are not.
  instantId      String?   @map("instant_id")
  // "nudity" | "harassment" | "violence" | "spam" | "other"
  reason         String
  details        String?
  // R2 key of a photo the reporter chose to attach, under `reports/`. The one
  // way plaintext of an instant ever reaches the server, and only by the
  // recipient's explicit choice. Deleted when the report is resolved.
  evidenceKey    String?   @map("evidence_key")
  // "open" | "resolved"
  status         String    @default("open")
  // "dismissed" | "suspended", set on resolution.
  resolution     String?
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  reporter     User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User? @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("content_reports")
}

// ---------------------------------------------------------------------------
// Shelf — /books, and whatever kind comes after it.
//
// Nothing here says "book" except the `kind` value. A movie or an album is a
// CatalogItem of another kind, a watch or a listen is a ShelfRun, and the
// feed, reviews and stats need no new tables. See wiki/books.md.
// ---------------------------------------------------------------------------

model CatalogItem {
  id         Int      @id @default(autoincrement())
  // "book"
  kind       String
  // "openlibrary" | "google" | "manual"
  source     String
  // The provider's own id. A manual entry gets a random one, so two people
  // adding "the same" book by hand get two items rather than a guess.
  externalId String   @map("external_id")
  title      String
  creators   String[]
  year       Int?
  // Where the provider serves the cover. Shown only until `coverKey` is set.
  coverUrl   String?  @map("cover_url")
  // The cover copied into R2 (`covers/<id>.<ext>`), served from our own
  // bucket through Cloudflare's resizing. Open Library limits cover requests
  // per viewer's IP, and is sometimes down; a copy is neither. See
  // backend/src/covers.ts.
  coverKey   String?  @map("cover_key")
  // ISBNs known to be editions of this work, collected as imports match
  // them. The next import of the same edition, by anyone, is found here
  // instead of costing Open Library a request.
  isbns      String[] @default([])
  // Pages, for a book. The edition the catalog found; each run keeps its own.
  totalUnits Int?     @map("total_units")
  genres     String[]
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  entries  ShelfEntry[]
  editions CatalogEdition[]

  @@unique([kind, source, externalId])
  @@index([isbns], type: Gin)
  @@map("catalog_items")
}

// Answers to book searches, kept for a day. A group reads the same books, so
// most searches have been made before, and every one served from here is one
// Open Library does not see. Only answers Open Library gave are kept; one
// assembled from the fallback alone would outlive the outage it came from.
model CatalogSearchCache {
  kind      String
  // Lower-cased, whitespace collapsed.
  query     String
  results   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@id([kind, query])
  @@index([createdAt])
  @@map("catalog_search_cache")
}

// One printing of a work, as somebody picked it. Shared, like the work: it
// is public metadata, and two readers of the same paperback share one cover
// copy. Only a ShelfEntry points at it, so a reader's edition changes their
// cover and title and never anybody else's. Keyed under its work, because
// resolveCandidate can land an Open Library edition on a work first filed
// from Google.
model CatalogEdition {
  id         Int      @id @default(autoincrement())
  itemId     Int      @map("item_id")
  // "openlibrary"
  source     String
  // "/books/OL…M"
  externalId String   @map("external_id")
  title      String
  // MARC code ("eng"), null when Open Library has none.
  language   String?
  publisher  String?
  year       Int?
  format     String?
  // As on CatalogItem: the URL to show, and `coverKey` once it is our copy
  // (`covers/editions/<id>.<ext>`). See backend/src/covers.ts.
  coverUrl   String?  @map("cover_url")
  coverKey   String?  @map("cover_key")
  totalUnits Int?     @map("total_units")
  createdAt  DateTime @default(now()) @map("created_at")

  item    CatalogItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  entries ShelfEntry[]

  @@unique([itemId, source, externalId])
  @@map("catalog_editions")
}

model ShelfEntry {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  itemId    Int       @map("item_id")
  // Non-null while it is on the want list.
  wantedAt  DateTime? @map("wanted_at")
  // The book this entry was imported as ("goodreads:<book id>"). A second
  // import finds the entry by this, never by matching the catalog again:
  // Open Library does not answer the same way twice, and a different match
  // would be a duplicate book.
  importId  String?   @map("import_id")
  // The edition this reader has, whose cover and title they see in place of
  // the work's. Null shows the work's own.
  editionId Int?      @map("edition_id")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  item    CatalogItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  edition CatalogEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  runs ShelfRun[]
  readerDocuments ReaderDocument[]

  @@unique([userId, itemId])
  @@unique([userId, importId])
  @@map("shelf_entries")
}

// One read-through. A re-read is a second run, never a reset of the first.
model ShelfRun {
  id         Int       @id @default(autoincrement())
  entryId    Int       @map("entry_id")
  // "active" | "finished" | "dnf". At most one active run per entry, enforced
  // in backend/src/route/shelf.ts.
  status     String    @default("active")
  startedOn  DateTime? @map("started_on") @db.Date
  finishedOn DateTime? @map("finished_on") @db.Date
  // This reader's edition. Book-club gating divides by it, never compares raw
  // pages across people.
  totalUnits Int?      @map("total_units")
  // Whether the reader confirmed `totalUnits` is their own copy's length,
  // rather than the catalog's median across editions. The book club's spoiler
  // gate adds a margin when it is not (UNCONFIRMED_MARGIN in
  // src/shelf-logic.ts).
  unitsConfirmed Boolean @default(false) @map("units_confirmed")
  position   Int       @default(0)
  // Where an imported run came from ("goodreads:<book id>"), so importing an
  // updated export again skips what is already here.
  importId   String?   @map("import_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  entry  ShelfEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  logs   ProgressLog[]
  review ShelfReview?

  @@unique([entryId, importId])
  @@index([entryId])
  @@index([status])
  @@map("shelf_runs")
}

model ProgressLog {
  id           Int      @id @default(autoincrement())
  runId        Int      @map("run_id")
  // Denormalised from the run so stats need no join.
  userId       Int      @map("user_id")
  // The reader's own calendar day, sent by the client.
  loggedOn     DateTime @map("logged_on") @db.Date
  fromPosition Int      @map("from_position")
  toPosition   Int      @map("to_position")
  // A book-club message, shown to others only once they have read this far.
  note         String?
  // The log a finished run closes with: the pages nobody logged, or a whole
  // backfilled book, put on the finish day. It counts as pages read but not as
  // a reading day, or one remembered book would be the year's best day.
  closing      Boolean  @default(false)
  // "koreader" for a log a KOReader sync wrote; null for one the reader did.
  // A sync extends the day's own "koreader" log rather than adding one per
  // page turn (src/reader-sync.ts).
  source       String?
  createdAt    DateTime @default(now()) @map("created_at")

  run  ShelfRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([userId, loggedOn])
  @@map("progress_logs")
}

model ShelfReview {
  id        Int       @id @default(autoincrement())
  runId     Int       @unique @map("run_id")
  // Half stars: 1..10.
  rating    Int?
  recommend Boolean?
  body      String?
  // The reviewer says it gives the book away. Covered, not withheld, for
  // anyone who has not finished the work: see src/shelf-spoilers.ts.
  spoiler   Boolean   @default(false)
  // Brought in from another service. Kept out of the review feed: an import
  // is years of reviews arriving at once, and would bury everyone's recent
  // ones. It shows on the reader's library and the book's page.
  imported  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")

  run        ShelfRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  comments   ShelfReviewComment[]
  loungePost Post?

  @@index([createdAt])
  @@map("shelf_reviews")
}

model ShelfReviewComment {
  id        Int       @id @default(autoincrement())
  reviewId  Int       @map("review_id")
  authorId  Int       @map("author_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")

  review ShelfReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("shelf_review_comments")
}

// One row per notification sent under a throttle: a key ("club:<item id>")
// per person per day. A book club that is busy all evening notifies each
// reader once, and the insert itself is the check, so two notes arriving at
// once cannot both get through. Kept a week, for the sweep to clear.
model NotificationSent {
  userId    Int      @map("user_id")
  key       String
  sentOn    DateTime @map("sent_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key, sentOn])
  @@index([sentOn])
  @@map("notifications_sent")
}

// KOReader's progress sync, served by src/route/kosync.ts. One login per
// person, made in /books: KOReader's Register button is refused.
model ReaderSync {
  userId     Int       @id @map("user_id")
  username   String    @unique
  // sha256 of the key KOReader sends, which is itself md5(password). Never
  // the md5: that is the credential, and KOReader stores it unsalted.
  keyHash    String    @map("key_hash")
  // The reader's IANA zone, from their browser at setup. A log is dated by the
  // reader's own day, and KOReader sends no day.
  timeZone   String    @map("time_zone")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reader_syncs")
}

// One file KOReader has synced. KOReader names it only by a hash, so it is
// unidentified (entryId null) until the reader, or the title KOReader may send
// with it, says which book it is.
model ReaderDocument {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  document   String
  entryId    Int?     @map("entry_id")
  // "Not a book I track": stored and served back to KOReader, never logged.
  ignored    Boolean  @default(false)
  // KOReader's own position (an xpointer or a page), handed back verbatim to
  // its other devices.
  progress   String
  percentage Float
  device     String
  deviceId   String   @map("device_id")
  // What KOReader says the file is, when "Send document metadata" is on.
  title      String?
  authors    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry ShelfEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@unique([userId, document])
  @@index([entryId])
  @@map("reader_documents")
}
